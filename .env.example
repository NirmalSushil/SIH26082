# Optional environment variables for WAQI API fallback
# This is a template file. Copy to .env.local and fill in actual values.
# Note: Open-Meteo (main APIs) requires NO keys and works completely free.

# WAQI API token (optional, for fallback/cross-check)
# Get token: https://waqi.info/
# NEXT_PUBLIC_WAQI_TOKEN=your_waqi_token_here

# Vercel analytics (optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id
